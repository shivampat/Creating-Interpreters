print "BREAK TEST:";
print "Should only output numbers 1-4";

var x = 0;
while (x < 10) {
    x = x + 1;
    if (x == 5) break; 
    print x;
}

print "CONTINUE TEST:";
print "Should skip number 5";

x = 0;
while (x < 10) {
    x = x + 1;
    if (x == 5) continue; 
    print x;
}

print "NESTED LOOP BREAK TEST:";

var y = 0;
x = 0;

while (x < 2) {
    while (y < 2) {
        if (x == 1) break;
        print x + ", " + y;
        y = y + 1;
    }
    x = x + 1;
}